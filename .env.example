# Copie para .env para sobrescrever os padrões. Não commite o .env.
# Portas publicadas no host (sempre em 127.0.0.1).
ATM_PORT=3000
UI_PORT=5173
ATM_MCP_PORT=3100
# Obrigatório: token do humano (o daemon recusa iniciar sem ele). Gere um valor longo e aleatório.
ATM_HUMAN_TOKEN=troque-por-um-token-longo-e-aleatorio
# Opcional: um token por agente, no formato id:token separados por vírgula.
ATM_AGENT_TOKENS=agente:troque-por-outro-token-longo-e-aleatorio
# Obrigatório para o MCP: token que o MCP usa na API (o mesmo valor de um agente acima) e que
# o cliente MCP deve enviar como Bearer. Nunca use o token do humano aqui.
ATM_AGENT_TOKEN=troque-por-outro-token-longo-e-aleatorio
# Segredos/credenciais de serviços futuros entram aqui, nunca no repositório.
