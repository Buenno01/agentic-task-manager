# Copie para .env para sobrescrever os padrões. Não commite o .env.
# Portas publicadas no host (sempre em 127.0.0.1).
ATM_PORT=3000
UI_PORT=5173
ATM_MCP_PORT=3100
# Obrigatório: token do humano (o daemon recusa iniciar sem ele, com valor de exemplo "troque-por…"
# ou com menos de 16 caracteres). Gere um valor longo e aleatório, ex.: openssl rand -hex 24
ATM_HUMAN_TOKEN=troque-por-um-token-longo-e-aleatorio
# Tokens de agentes, no formato id:token separados por vírgula (mesmas regras do token humano).
# OBRIGATÓRIO incluir o agente "orquestrador": é o token que o processo de cada Rodada recebe (ADR-0008).
ATM_AGENT_TOKENS=orquestrador:troque-por-outro-token-longo-e-aleatorio
# Obrigatório para o MCP: DEVE ser igual ao token do agente "orquestrador" acima e é o
# Bearer que o agente da Rodada envia ao MCP. Nunca use o token do humano aqui.
ATM_AGENT_TOKEN=troque-por-outro-token-longo-e-aleatorio
# Opcional: origens CORS permitidas na API (vírgula). Padrão: http://127.0.0.1:5173,http://localhost:5173.
# Ajuste se mudar UI_PORT ou servir a UI em outro endereço.
# ATM_CORS_ORIGIN=http://127.0.0.1:5173
# Opcional: teto global de Rodadas simultâneas (Exploração e Execução contam igual). Padrão: 2.
# ATM_MAX_RODADAS=2
# Opcional: onde ficam os clones dos repositórios dos Contextos e os Workspaces (worktrees).
# No Compose já apontam para os volumes atm-repos (/data/repos) e atm-workspaces (/data/workspaces);
# só precisam ser definidos ao rodar o daemon fora do Compose.
# ATM_REPOS_DIR=./data/repos
# ATM_WORKSPACES_DIR=./data/workspaces
# Segredos/credenciais de serviços futuros entram aqui, nunca no repositório.
